{
  "name": "@ubinity/node-llm",
  "version": "2.3.1",
  "description": "One calling contract for OpenAI and OpenAI-compatible servers, Anthropic and Gemini -- by API key or by subscription.",
  "author": "Ubinity DX Team <dx@ubinity.tech>",
  "license": "MPL-2.0",
  "keywords": [
    "llm",
    "ai",
    "openai",
    "anthropic",
    "gemini",
    "claude",
    "codex",
    "antigravity",
    "ollama",
    "deepseek",
    "qwen",
    "subscription",
    "unified"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ubinity-dx/node-llm.git"
  },
  "bugs": {
    "url": "https://github.com/ubinity-dx/node-llm/issues"
  },
  "homepage": "https://github.com/ubinity-dx/node-llm#readme",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "types": "index.d.ts",
  "files": [
    "lib",
    "index.js",
    "index.d.ts",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@google/genai": "^2.31.0",
    "openai": "^7.43.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "scripts": {
    "test": "jest && node --test tests/node/contract.test.js tests/node/sdk-conformance.test.js tests/node/attribution.test.js",
    "test:live:ollama": "node tests/live/ollama.live.js",
    "test:live:api": "node tests/live/api.live.js",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@google/genai": "2.31.0",
    "jest": "^30.4.2",
    "openai": "7.43.0"
  },
  "directories": {
    "lib": "lib",
    "test": "tests"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/node/"
    ]
  }
}
